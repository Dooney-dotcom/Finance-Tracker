# Copy to .env.local. These are public values (shipped to the browser); no secrets here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:8080
# Sign out after this many idle minutes. The API enforces its own SESSION_IDLE_TIMEOUT; keep them equal.
VITE_SESSION_IDLE_MINUTES=30
