# Copy to .env for local runs. On Cloud Run set these as env vars / Secret Manager.
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase pooler (session mode). Works over IPv4, unlike the direct db host.
# verify-full checks the server certificate against Supabase's root CA (supabase-ca.crt, next to this file) and the host name.
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=supabase-ca.crt
DB_USER=finance_api.<project-ref>
DB_PASSWORD=
CORS_ORIGINS=http://localhost:5173
# Idle time before a session is refused, e.g. 30m or 1h. Keep VITE_SESSION_IDLE_MINUTES in web/.env.local equal.
SESSION_IDLE_TIMEOUT=30m
