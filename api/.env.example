# Copy to .env for local runs. On Cloud Run set these as env vars / Secret Manager.
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase pooler (session mode). Works over IPv4, unlike the direct db host.
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=finance_api.<project-ref>
DB_PASSWORD=
CORS_ORIGINS=http://localhost:5173
